extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/product-layout.pug

block main 
  .home
    .bg.bg1
    .bg.bg2
    img.home-img.home-img1(src="/images/BG1_1.png")
    img.home-img.home-img2(src="/images/BG2_1.webp")
    .home-section
      .section-products-featured.my-5 
        .container
          .row 
            .col-12 
              +box-head("Sản phẩm nổi bật")
          .box
            +product-grid(productsFeatured)
      
      .section-products-new.my-5 
        .container 
          .row 
            .col-12 
              +box-head("Sản phẩm mới")
          .box
            +product-grid(productsNew)