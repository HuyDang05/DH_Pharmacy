.row.user-dashboard.text-center
  .col
    a.dashboard-card(href="/users/not-friend")
      i.fas.fa-users
      span Người dùng
  .col
    a.dashboard-card(href="/users/friends")
      i.fas.fa-user-friends
      span Bạn bè
  .col
    a.dashboard-card(href="/users/request")
      i.fas.fa-paper-plane
      span Lời mời đã gửi
  .col
    a.dashboard-card(href="/users/accept")
      i.fas.fa-user-plus
      span
        | Lời mời kết bạn 
        span.badge.badge-danger #{user.acceptFriends.length}
  .col
    a.dashboard-card(href="/rooms-chat")
      i.fas.fa-comments
      span Phòng chat
