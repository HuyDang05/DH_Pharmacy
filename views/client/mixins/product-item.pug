mixin product-item(item)
  .col-4.mb-3 
    .product-item
      .inner-image
         a(href=`/products/detail/${item.slug}`)
          img(src=item.thumbnail, alt=item.title)
          if item.featured == "1"
            .inner-featured HOT!!
      .inner-content
        h3.inner-title
          a(href=`/products/detail/${item.slug}`) #{item.title}
        if item.discountPercentage && item.discountPercentage > 0
          .inner-discount Khuyến mãi #{item.discountPercentage}%
        .inner-price
          if item.price && item.price > item.priceNew
            span.inner-price-old #{item.price}.000đ
            |  >>
          span.inner-price-new #{item.priceNew}.000đ        
        form(
            action=`/cart/add/${item.id}`
            method="POST"
          )
            input(
              type="hidden"
              name="quantity"
              value="1"
            )
            button(
              type="submit"
              class="btn btn-success btn-block"
            ) Chọn mua
